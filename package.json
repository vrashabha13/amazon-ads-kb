{
  "name": "amazon-ads-kb",
  "version": "1.0.0",
  "description": "Amazon Ads Knowledge Base - Automated knowledge acquisition pipeline",
  "main": "scripts/ingest.js",
  "scripts": {
    "ingest": "node scripts/ingest.js",
    "test": "node tests/pipeline.test.js",
    "test:idempotency": "node tests/idempotency.test.js",
    "test:two-run": "node tests/two-run-idempotency.test.js",
    "test:hash": "node scripts/hash.js",
    "test:quality": "node tests/knowledge-quality.test.js",
    "test:hook": "./tests/test-hook-integration.sh",
    "test:source-change": "node tests/source-change.test.js",
    "test:conflicts": "node tests/conflict-resolution.test.js",
    "test:fact-id": "node scripts/fact-id.js",
    "test:all-new": "npm run test:source-change && npm run test:conflicts && npm run test:fact-id"
  },
  "keywords": [
    "amazon-ads",
    "knowledge-base",
    "pipeline",
    "claude-code"
  ],
